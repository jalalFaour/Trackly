<%- include('partials/header') %>

<div class="container-fluid px-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Edit Bus</h1>
      <p class="text-muted small mb-0">Update bus details and optionally reassign it to a route.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/buses" class="btn btn-sm btn-light border d-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i> Back to Buses
      </a>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-4">
          <form id="editBusForm">
            <input type="hidden" name="busId" value="<%= bus._id %>" />

            <div class="row g-3">
              <div class="col-12">
                <label class="form-label small text-muted">Hardware Device ID</label>
                <input class="form-control" name="deviceId" type="text" value="<%= bus.deviceId %>" required />
              </div>

              <div class="col-12">
                <label class="form-label small text-muted">Bus Number</label>
                <input class="form-control" name="busNumber" type="text" value="<%= bus.busNumber %>" required />
              </div>

              <div class="col-12">
                <label class="form-label small text-muted">Status</label>
                <select class="form-select" name="status">
                  <option value="idle" <%= bus.status === 'idle' ? 'selected' : '' %>>idle</option>
                  <option value="active" <%= bus.status === 'active' ? 'selected' : '' %>>active</option>
                  <option value="maintenance" <%= bus.status === 'maintenance' ? 'selected' : '' %>>maintenance</option>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label small text-muted">Assign to Route (optional)</label>
                <select class="form-select" name="routeId">
                  <option value="" <%= !bus.routeId ? 'selected' : '' %>>Unassigned</option>
                  <% if (routesForAdmin && routesForAdmin.length) { %>
                  <% routesForAdmin.forEach(r => { %>
                  <option value="<%= r._id %>" <%= bus.routeId && bus.routeId._id && bus.routeId._id.toString() === r._id.toString() ? 'selected' : '' %>>
                    <%= r.routeName %>
                  </option>
                  <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-check2-circle me-1"></i> Save Changes
                </button>
                <button type="button" class="btn btn-outline-secondary px-4" onclick="window.location.href='/buses'">
                  Cancel
                </button>

                <button type="button" class="btn btn-outline-danger px-4 ms-auto" onclick="deleteBus('<%= bus._id %>')">
                  <i class="bi bi-trash me-1"></i> Delete
                </button>
              </div>

              <div class="col-12">
                <div id="formError" class="alert alert-danger d-none" role="alert"></div>
                <div id="formSuccess" class="alert alert-success d-none" role="alert"></div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-4">
          <h2 class="h6 fw-bold text-secondary text-uppercase tracking-wider mb-3">Current Summary</h2>

          <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-center justify-content-between gap-2">
              <span class="text-muted small">Bus</span>
              <span class="fw-semibold text-dark"><%= bus.busNumber %></span>
            </div>
            <div class="d-flex align-items-center justify-content-between gap-2">
              <span class="text-muted small">Device</span>
              <span class="fw-semibold text-dark font-monospace"><%= bus.deviceId %></span>
            </div>
            <div class="d-flex align-items-center justify-content-between gap-2">
              <span class="text-muted small">Status</span>
              <span class="badge bg-light text-dark border px-2 py-1 text-capitalize"><%= bus.status %></span>
            </div>
            <div class="d-flex align-items-center justify-content-between gap-2">
              <span class="text-muted small">Route</span>
              <% if (bus.routeId) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"> <%= bus.routeId.routeName %></span>
              <% } else { %>
              <span class="badge bg-light text-secondary border px-2 py-1">Unassigned</span>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setError(message) {
    const el = document.getElementById('formError');
    const successEl = document.getElementById('formSuccess');
    if (successEl) successEl.classList.add('d-none');
    el.textContent = message || 'Something went wrong.';
    el.classList.remove('d-none');
  }

  function setSuccess(message) {
    const el = document.getElementById('formError');
    const successEl = document.getElementById('formSuccess');
    if (el) el.classList.add('d-none');
    successEl.textContent = message || 'Saved.';
    successEl.classList.remove('d-none');
  }

  document.getElementById('editBusForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target;
    const formData = new FormData(form);

    const payload = {
      deviceId: formData.get('deviceId'),
      busNumber: formData.get('busNumber'),
      status: formData.get('status'),
      routeId: formData.get('routeId') || null
    };

    const busId = formData.get('busId');

    try {
      const res = await fetch(`/api/company/buses/${busId}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const json = await res.json().catch(() => ({}));

      if (!res.ok || !json.success) {
        setError(json.message || json.error || 'Failed to update bus.');
        return;
      }

      setSuccess('Bus updated successfully. Redirecting...');
      setTimeout(() => {
        window.location.href = '/buses';
      }, 700);
    } catch (err) {
      setError(err?.message || 'Failed to update bus.');
    }
  });

  async function deleteBus(busId) {
    const ok = window.confirm('Delete this bus? This action cannot be undone.');
    if (!ok) return;

    try {
      const res = await fetch(`/api/company/buses/${busId}`, {
        method: 'DELETE'
      });

      const json = await res.json().catch(() => ({}));

      if (!res.ok || !json.success) {
        setError(json.message || json.error || 'Failed to delete bus.');
        return;
      }

      window.location.href = '/buses';
    } catch (err) {
      setError(err?.message || 'Failed to delete bus.');
    }
  }
</script>

<%- include('partials/footer') %>