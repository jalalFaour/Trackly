<%- include('partials/header') %>

<div class="d-flex align-items-center justify-content-center bg-light" style="min-height: 75vh;">
  <div class="container text-center" style="max-width: 520px;">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="bg-danger" style="height: 5px;"></div>

      <div class="card-body p-4 p-sm-5">
        <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 64px; height: 64px;">
          <i class="bi bi-exclamation-octagon fs-2"></i>
        </div>

        <h1 class="h4 fw-bold text-dark mb-2">Something went wrong</h1>
        <p class="text-muted small mb-4">The application layer encountered an unhandled execution exception or validation problem.</p>

        <div class="p-3 bg-light rounded-3 border text-start mb-4">
          <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
            <span class="text-muted small fw-medium">HTTP Error Code</span>
            <span class="badge bg-danger text-white font-monospace px-2.5 py-1 fs-6 rounded"><%= statusCode %></span>
          </div>
          <div>
            <span class="text-muted small d-block mb-1 fw-medium">Exception Diagnostics Details</span>
            <div class="text-dark font-monospace small bg-white p-2.5 rounded border border-light text-wrap-break" style="word-break: break-all;">
              <%= message %>
            </div>
          </div>
        </div>

        <a href="/" class="btn btn-primary shadow-sm px-4 py-2.5 rounded-3 d-inline-flex align-items-center gap-2 fw-semibold">
          <i class="bi bi-house-door small"></i> Back to Dashboard
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Dynamic focus structure adjustment rules overrides */
  .btn-primary:focus {
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
  }
</style>

<%- include('partials/footer') %>