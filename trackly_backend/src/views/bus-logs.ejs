<%- include('partials/header') %>

<div class="container-fluid px-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <i class="bi bi-bus-front text-primary fs-3"></i>
        <h1 class="h3 fw-bold text-dark mb-0">Bus Logs: <%= bus.busNumber %></h1>
      </div>
      <p class="text-muted small mb-0">Historical telemetry data stream and device diagnostics feed.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <a href="/buses" class="btn btn-sm btn-light border d-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i> Back to Buses
      </a>
      <a href="/api/buses/<%= bus._id %>/qrcode.png" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-2" title="Download bus QR code PNG">
        <i class="bi bi-qr-code"></i> Download QR
      </a>
    </div>
  </div>


  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="bg-light text-secondary rounded-3 p-2.5 fs-4 d-flex align-items-center justify-content-center">
            <i class="bi bi-cpu"></i>
          </div>
          <div>
            <span class="text-muted small d-block">Hardware Device ID</span>
            <span class="fw-semibold text-dark font-monospace"><%= bus.deviceId %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="bg-light text-secondary rounded-3 p-2.5 fs-4 d-flex align-items-center justify-content-center">
            <i class="bi bi-activity"></i>
          </div>
          <div>
            <span class="text-muted small d-block">Operational Status</span>
            <% if (bus.status === 'active' || bus.status === 'running') { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 text-capitalize"><%= bus.status %></span>
            <% } else { %>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 text-capitalize"><%= bus.status %></span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="bg-light text-secondary rounded-3 p-2.5 fs-4 d-flex align-items-center justify-content-center">
            <i class="bi bi-geo-alt"></i>
          </div>
          <div>
            <span class="text-muted small d-block">Last Known Location</span>
            <span class="fw-semibold text-dark small font-monospace">[<%= bus.lastLocation.coordinates[0] %>, <%= bus.lastLocation.coordinates[1] %>]</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-2">
      <i class="bi bi-database text-muted"></i>
      <h2 class="h6 mb-0 fw-bold text-secondary text-uppercase tracking-wider">Historical Logs Stream</h2>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-uppercase tracking-wider" style="font-size: 0.75rem;">
          <tr>
            <th class="px-4 py-3 text-muted fw-semibold">Timestamp</th>
            <th class="px-4 py-3 text-muted fw-semibold">Longitude</th>
            <th class="px-4 py-3 text-muted fw-semibold">Latitude</th>
            <th class="px-4 py-3 text-muted fw-semibold">Speed</th>
          </tr>
        </thead>
        <tbody class="border-top-0">
          <% if (!logs || !logs.length) { %>
          <tr>
            <td colspan="4" class="text-center py-5 text-muted">
              <i class="bi bi-clock-history display-6 d-block mb-2 text-secondary"></i>
              No historical log telemetry records registered yet.
            </td>
          </tr>
          <% } else { %>
          <% logs.forEach(log => { %>
          <tr>
            <td class="px-4 py-3 text-dark fw-medium">
              <%= new Date(log.timestamp).toLocaleString() %>
            </td>
            <td class="px-4 py-3 text-secondary font-monospace">
              <%= log.location.coordinates[0] %>
            </td>
            <td class="px-4 py-3 text-secondary font-monospace">
              <%= log.location.coordinates[1] %>
            </td>
            <td class="px-4 py-3">
              <span class="badge bg-light text-dark border px-2 py-1 font-monospace fw-semibold fs-6">
                <%= log.speed %> <small class="text-muted fw-normal">km/h</small>
              </span>
            </td>
          </tr>
          <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .tracking-wider {
    letter-spacing: 0.05em;
  }

  .table-hover tbody tr:hover {
    background-color: #f8fafc;
  }
</style>

<%- include('partials/footer') %>