<%- include('partials/header') %>
<div class="container-fluid px-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Active Routes</h1>
      <p class="text-muted small mb-0">Monitor and manage company transit networks and live telemetry streams.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/buses" class="btn btn-sm btn-light border d-flex align-items-center gap-2">
        <i class="bi bi-journal-text"></i> Buses & Logs
      </a>

      <a href="/add-route" class="btn btn-sm btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Create New Route
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="position-relative d-inline-block" style="width: 10px; height: 10px;">
          <span class="position-absolute top-0 start-0 w-100 h-100 bg-success rounded-circle opacity-75 animate-ping" id="statusPulse" style="animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;"></span>
          <span class="position-relative d-inline-block w-100 h-100 bg-success rounded-circle"></span>
        </div>
        <div>
          <span class="fw-semibold text-secondary small d-block">Real-Time Telemetry</span>
          <div id="realtimeStatus" class="small text-success fw-medium">Connecting...</div>
        </div>
      </div>
      <span class="badge bg-light text-secondary border px-2 py-1.5 rounded small font-monospace">SSE Protocol</span>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center gap-2">
      <i class="bi bi-bar-chart-line text-muted"></i>
      <h2 class="h6 mb-0 fw-bold text-secondary text-uppercase tracking-wider">Revenue Analytics</h2>
    </div>
    <div class="card-body p-3">
      <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
              <div class="d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="text-muted small">Revenue (Income)</div>
                  <div class="h4 fw-bold text-dark mb-0">SYP <%= (revenueAnalytics && typeof revenueAnalytics.revenue === 'number') ? revenueAnalytics.revenue.toFixed(2) : '0.00' %></div>
                </div>
                <div class="bg-primary-subtle text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                  <i class="bi bi-wallet2"></i>
                </div>
              </div>
              <div class="text-muted small mt-2">
                Period: <span class="font-monospace"><%= (revenueAnalytics && revenueAnalytics.from) ? new Date(revenueAnalytics.from).toLocaleDateString() : '' %></span>
                → <span class="font-monospace"><%= (revenueAnalytics && revenueAnalytics.to) ? new Date(revenueAnalytics.to).toLocaleDateString() : '' %></span>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
              <div class="d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="text-muted small">Income Transactions</div>
                  <div class="h4 fw-bold text-dark mb-0"><%= (revenueAnalytics && typeof revenueAnalytics.transactionsCount === 'number') ? revenueAnalytics.transactionsCount : 0 %></div>
                </div>
                <div class="bg-success-subtle text-success rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                  <i class="bi bi-arrow-up-right-circle"></i>
                </div>
              </div>
              <div class="text-muted small mt-2">Ledger inflows recorded as Transaction.type = credit.</div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
              <div class="d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="text-muted small">Routes with Income</div>
                  <div class="h4 fw-bold text-dark mb-0"><%= (routeRevenueAnalytics && routeRevenueAnalytics.routes && Array.isArray(routeRevenueAnalytics.routes)) ? routeRevenueAnalytics.routes.length : 0 %></div>
                </div>
                <div class="bg-danger-subtle text-danger rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                  <i class="bi bi-signpost-2"></i>
                </div>
              </div>
              <div class="text-muted small mt-2">Count of routes with credit transactions in the period.</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-2">
          <i class="bi bi-signpost-2 text-muted"></i>
          <h3 class="h6 mb-0 fw-bold text-secondary text-uppercase tracking-wider">Revenue by Route</h3>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light border-bottom text-uppercase tracking-wider" style="font-size: 0.75rem;">
              <tr>
                <th class="px-4 py-3 text-muted fw-semibold">Route Name</th>
                <th class="px-4 py-3 text-muted fw-semibold">Revenue (Income)</th>
              </tr>
            </thead>
            <tbody class="border-top-0">
              <% if (routeRevenueAnalytics && routeRevenueAnalytics.routes && routeRevenueAnalytics.routes.length > 0) { %>
              <% routeRevenueAnalytics.routes.forEach(r => { %>
              <tr>
                <td class="px-4 py-3">
                  <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                      <i class="bi bi-signpost-2"></i>
                    </div>
                    <span class="fw-semibold text-dark"><%= r.routeName %></span>
                  </div>
                </td>
                <td class="px-4 py-3 text-secondary">SYP <%= (typeof r.revenue === 'number') ? r.revenue.toFixed(2) : '0.00' %></td>
              </tr>
              <% }) %>
              <% } else { %>
              <tr>
                <td colspan="4" class="text-center py-5 text-muted">
                  <i class="bi bi-cash-stack display-6 d-block mb-2 text-secondary"></i>
                  No revenue transactions found for this period.
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light border-bottom text-uppercase tracking-wider" style="font-size: 0.75rem;">
          <tr>
            <th class="px-4 py-3 text-muted fw-semibold">Route Name</th>
            <th class="px-4 py-3 text-muted fw-semibold">Waypoints Count</th>
            <th class="px-4 py-3 text-muted fw-semibold text-end">Actions</th>
          </tr>
        </thead>
        <tbody class="border-top-0">
          <% if (routes && routes.length > 0) { %>
          <% routes.forEach(route => { %>
          <tr>
            <td class="px-4 py-3">
              <div class="d-flex align-items-center gap-2">
                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                  <i class="bi bi-signpost-2"></i>
                </div>
                <div>
                  <span class="fw-semibold text-dark d-block"><%= route.routeName %></span>
                  <span class="text-muted small">Length: <%= typeof route.routeLengthKm === 'number' ? route.routeLengthKm.toFixed(2) + ' km' : '0.00 km' %></span>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-secondary">
              <span class="badge bg-light text-dark border px-2 py-1"><%= route.path.coordinates.length %> coordinates</span>
            </td>
            <td class="px-4 py-3 text-end">
              <a href="/view-route/<%= route._id %>" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                <i class="bi bi-geo-alt me-1"></i> View on Map
              </a>
            </td>
          </tr>
          <% }) %>
          <% } else { %>
          <tr>
            <td colspan="3" class="text-center py-5 text-muted">
              <i class="bi bi-folder2-open display-6 d-block mb-2 text-secondary"></i>
              No routes found. Get started by creating a new one.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  @keyframes pulse {

    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: .2;
      transform: scale(2);
    }
  }

  .table-hover tbody tr:hover {
    background-color: #f8fafc;
  }

  .tracking-wider {
    letter-spacing: 0.05em;
  }
</style>

<script>
  (function() {
    const statusEl = document.getElementById('realtimeStatus');
    const pulseEl = document.getElementById('statusPulse');
    if (!window.EventSource || !statusEl) return;

    const es = new EventSource('/api/realtime/sse');

    function updateStatus(text, type) {
      statusEl.textContent = text;
      if (type === 'live' || type === 'connected') {
        statusEl.className = 'small text-success fw-medium';
        if (pulseEl) pulseEl.style.display = 'inline-block';
      } else {
        statusEl.className = 'small text-danger fw-medium';
        if (pulseEl) pulseEl.style.display = 'none';
      }
    }

    es.addEventListener('message', (e) => {
      try {
        const payload = JSON.parse(e.data);
        if (payload && payload.type === 'bus_location_updated') {
          updateStatus('Live: Location updated at ' + new Date().toLocaleTimeString(), 'live');
        }
      } catch (_) {}
    });

    es.onopen = function() {
      updateStatus('Connected at ' + new Date().toLocaleTimeString(), 'connected');
    };

    es.onerror = function() {
      updateStatus('Disconnected (reconnecting...)', 'error');
    };
  })();
</script>
<%- include('partials/footer') %>