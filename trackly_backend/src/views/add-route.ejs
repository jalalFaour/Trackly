<%- include('partials/header') %>

<div class="container-fluid px-4 py-3">
  <div class="mb-4">
    <h1 class="h3 fw-bold text-dark mb-1">Create New Bus Route</h1>
    <p class="text-muted small mb-0">Use the interactive map to plot points and deploy a new operational transit path.</p>
  </div>

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center gap-2 mb-4">
              <i class="bi bi-sliders text-primary fs-5"></i>
              <h2 class="h5 mb-0 fw-semibold">Route Properties</h2>
            </div>

            <div class="form-floating mb-3">
              <input type="text" id="routeName" class="form-control" placeholder="e.g. Line 10 - Airport" autocomplete="off">
              <label for="routeName" class="text-muted">Route Name</label>
            </div>

            <div class="p-3 bg-light rounded-3 border mb-4">
              <div class="d-flex gap-2">
                <i class="bi bi-info-circle text-primary mt-0.5"></i>
                <div>
                  <h6 class="small fw-semibold mb-1">How to plot paths:</h6>
                  <p class="small text-muted mb-0">Click directly on the map surface to start adding serial waypoints. A connecting path vector will automatically render between successive points.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="d-grid gap-2">
            <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2" onclick="saveRoute()">
              <i class="bi bi-cloud-arrow-up"></i> Save Route to Database
            </button>
            <button class="btn btn-outline-danger d-flex align-items-center justify-content-center gap-2" onclick="clearMap()">
              <i class="bi bi-trash"></i> Clear Map Canvas
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-2 bg-white">
          <div id="map"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #map {
    height: 600px;
    width: 100%;
    border-radius: 0.5rem;
    z-index: 1;
  }

  .form-control:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
  }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  // Center coordinate mapping initialization
  const map = L.map('map').setView([36.1984372, 37.1481231], 13);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap',
    referrerPolicy: 'origin-when-cross-origin'
  }).addTo(map);

  let routeCoordinates = [];

  // Custom Polyline Styling matching modern SaaS brand colors (Indigo/Blue Accent)
  let polyline = L.polyline([], {
    color: '#4f46e5',
    weight: 4,
    opacity: 0.85,
    lineJoin: 'round'
  }).addTo(map);

  // Canvas map click processing logic
  map.on('click', function(e) {
    const {
      lat,
      lng
    } = e.latlng;
    routeCoordinates.push([lng, lat]); // Format coordinates for structured GeoJSON properties [lng, lat]
    polyline.addLatLng(e.latlng);

    // Smooth circle markup rendering for point indicators
    L.circleMarker(e.latlng, {
      radius: 4,
      fillColor: '#ffffff',
      fillOpacity: 1,
      color: '#4f46e5',
      weight: 2
    }).addTo(map);
  });

  async function saveRoute() {
    const name = document.getElementById('routeName').value.trim();
    if (!name || routeCoordinates.length < 2) {
      return alert("Please enter a name and draw at least two points on the map.");
    }

    const response = await fetch('/api/routes', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        routeName: name,
        coordinates: routeCoordinates
      })
    });

    if (response.ok) {
      alert("Route saved successfully!");
      window.location.href = "/";
    }
  }

  function clearMap() {
    location.reload();
  }
</script>

<%- include('partials/footer') %>