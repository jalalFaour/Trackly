<%- include('partials/header') %>

<div class="container-fluid px-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Company Fleet Management</h1>
      <p class="text-muted small mb-0">Assign hardware telemetry tracking units to operational route pathways.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/add-bus" class="btn btn-sm btn-secondary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Add New Bus
      </a>

      <a href="/" class="btn btn-sm btn-light border d-flex align-items-center gap-2">
        <i class="bi bi-grid-1x2"></i> Back to Dashboard
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4 bg-white">
    <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <div class="spinner-grow spinner-grow-sm text-success" role="status"></div>
        <span class="small text-secondary fw-medium">Real-time asynchronous updates active (SSE)</span>
      </div>
      <div class="small text-muted">
        <i class="bi bi-info-circle me-1"></i> Match a tracking device with a route below and save.
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-uppercase tracking-wider" style="font-size: 0.75rem;">
          <tr>
            <th class="px-4 py-3 text-muted fw-semibold">Bus Number</th>
            <th class="px-4 py-3 text-muted fw-semibold">Hardware Device ID</th>
            <th class="px-4 py-3 text-muted fw-semibold">Status</th>
            <th class="px-4 py-3 text-muted fw-semibold">Assigned Route</th>
            <th class="px-4 py-3 text-muted fw-semibold">Telemetry Last Update</th>
            <th class="px-4 py-3 text-muted fw-semibold text-end">Deployment Actions</th>
          </tr>
        </thead>
        <tbody class="border-top-0">
          <% if (!buses || !buses.length) { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-bus-front-fill display-6 d-block mb-2 text-secondary"></i>
              No operational buses cataloged yet. Please stream physical hardware logs first.
            </td>
          </tr>
          <% } else { %>
          <% buses.forEach(bus => { %>
          <tr>
            <td class="px-4 py-3 fw-bold text-dark">
              <a href="/buses/<%= bus._id %>/logs" class="text-decoration-none text-dark">
                <div class="d-flex align-items-center gap-2">
                  <span class="p-1.5 bg-light rounded text-primary"><i class="bi bi-truck-front"></i></span>
                  <%= bus.busNumber %>
                </div>
              </a>
            </td>


            <td class="px-4 py-3 text-secondary font-monospace small">
              <%= bus.deviceId %>
            </td>

            <td class="px-4 py-3">
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded text-capitalize small">
                <%= bus.status %>
              </span>
            </td>

            <td class="px-4 py-3">
              <% if (bus.routeId) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded">
                <i class="bi bi-signpost-2 me-1"></i> <%= bus.routeId.routeName %>
              </span>
              <% } else { %>
              <span class="badge bg-light text-secondary border px-2.5 py-1 rounded">
                <i class="bi bi-dash-circle me-1"></i> Unassigned
              </span>
              <% } %>
            </td>

            <td class="px-4 py-3 text-muted small">
              <%= bus.lastUpdate ? new Date(bus.lastUpdate).toLocaleString() : '—' %>
            </td>

            <td class="px-4 py-3 text-end">
              <div class="d-inline-flex flex-column align-items-end gap-2">
                <div class="input-group input-group-sm rounded shadow-sm" style="min-width: 290px;">
                  <select class="form-select routeSelect" data-bus-id="<%= bus._id %>">
                    <option value="__null__">Unassigned / Remove Route</option>
                    <% if (routesForAdmin && routesForAdmin.length) { %>
                    <% routesForAdmin.forEach(r => { %>
                    <option value="<%= r._id %>" <%= bus.routeId && bus.routeId._id.toString() === r._id.toString() ? 'selected' : '' %>><%= r.routeName %></option>
                    <% }) %>
                    <% } %>
                  </select>
                  <button class="btn btn-primary fw-medium px-3" onclick="assignBus('<%= bus._id %>')">
                    Assign
                  </button>

                  <a href="/buses/<%= bus._id %>/edit" class="btn btn-outline-primary fw-medium px-3" title="Edit bus">
                    Edit
                  </a>

                  <button class="btn btn-outline-danger fw-medium px-3" onclick="deleteBus('<%= bus._id %>')" title="Delete bus">
                    Delete
                  </button>
                </div>

              </div>
            </td>
          </tr>
          <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>


<style>
  .tracking-wider {
    letter-spacing: 0.05em;
  }

  .table-hover tbody tr:hover {
    background-color: #f8fafc;
  }

  .form-select:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
  }
</style>

<script>
  async function assignBus(busId) {
    const select = document.querySelector(`select.routeSelect[data-bus-id="${busId}"]`);
    if (!select) return;

    const routeId = select.value;
    const payload = {
      busId,
      routeId: routeId === '__null__' ? null : routeId
    };

    const res = await fetch('/api/company/assign-bus', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    });

    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.success) {
      alert(json.message || 'Failed to assign bus operational vector.');
      return;
    }

    window.location.reload();
  }

  async function deleteBus(busId) {
    const ok = window.confirm('Delete this bus? This action cannot be undone.');
    if (!ok) return;

    const res = await fetch(`/api/company/buses/${busId}`, {
      method: 'DELETE'
    });

    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.success) {
      alert(json.message || json.error || 'Failed to delete bus.');
      return;
    }

    window.location.reload();
  }
</script>

<%- include('partials/footer') %>